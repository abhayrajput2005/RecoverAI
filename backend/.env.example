# Copy this file to .env and fill in your real key. Never commit .env itself.

GEMINI_API_KEY=your-gemini-api-key-here

# Model used for the ambiguous-case recovery agent. Check
# https://ai.google.dev/gemini-api/docs/models for current model names —
# gemini-2.5-flash is a good default: fast and cheap for structured,
# short-context decisions like this one.
GEMINI_MODEL=gemini-2.5-flash

# Razorpay TEST MODE keys only — from the Razorpay dashboard, Settings ->
# API Keys, with "Test Mode" toggled on. Never put live keys here.
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret

# Set this after creating a webhook in the Razorpay dashboard (Settings ->
# Webhooks), subscribed to payment.captured, payment.failed, payment_link.paid.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# SQLite by default; swap for a Postgres URL on the deployed demo (Day 10).
DATABASE_URL=sqlite:///./recoverai.db
